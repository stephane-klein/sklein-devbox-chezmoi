#!/usr/bin/env bash
set -euo pipefail

if [[ $# -lt 1 ]]; then
    echo "Usage: sklein-devbox-backup <path> [tag...]" >&2
    exit 1
fi

source_dir="$1"; shift

export OPENDAL_ACCESS_KEY_ID="$(gopass show -o scaleway/sklein-devbox-rustic-backup/SCW_ACCESS_KEY)"
export OPENDAL_SECRET_ACCESS_KEY="$(gopass show -o scaleway/sklein-devbox-rustic-backup/SCW_SECRET_KEY)"

args=(--init --host "$(uname -n)" --tag "machine-id-$(cat /etc/machine-id)")
for tag in "$@"; do
    args+=(--tag "${tag#--}")
done

exec rustic backup "$source_dir" "${args[@]}"
